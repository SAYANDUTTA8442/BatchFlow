APP_NAME=BatchFlow API
APP_ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://batchflow:change-me-local-only@localhost:5432/batchflow
SQLALCHEMY_ECHO=false
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_KEY_ID=local-v1
JWT_PREVIOUS_KEYS=
JWT_ISSUER=batchflow-api
JWT_AUDIENCE=batchflow-client
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REFRESH_COOKIE_SECURE=false
